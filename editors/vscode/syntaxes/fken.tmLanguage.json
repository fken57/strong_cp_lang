{
  "name": "fken_cpl",
  "scopeName": "source.fken",
  "patterns": [
    { "name": "comment.line.double-slash.fken", "begin": "//", "end": "$" },
    {"name": "string.quoted.double.fken", "match": "\"(?:\\\\.|[^\"\\\\])*\""},
    {"name": "string.quoted.single.fken", "match": "'(?:\\\\.|[^'\\\\])*'"},
    { "name": "keyword.control.fken", "match": "\\b(?:struct|let|auto|fn|return|if|else|while|for|rep|break)\\b" },
    { "name": "storage.type.fken", "match": "\\b(?:int|char|string|void|graph|digraph|edge|pair)\\b" },
    { "name": "support.function.fken", "match": "\\b(?:add|edge_count|sort|at_least|more_than|at_most|less_than|run_length|cin|cout|print|read_char|read_string|read_int|read_vec|array|len|push_back|push|pop|back|size|resize|clear)\\b" },
    { "name": "entity.name.function.fken", "match": "\\b[A-Za-z_][A-Za-z_0-9]*(?=\\s*\\()" },
    { "name": "constant.numeric.integer.fken", "match": "\\b[0-9]+\\b" },
    { "name": "keyword.operator.fken", "match": "->|\\+\\+|--|[+*/<>=!&-]" },
    { "name": "punctuation.separator.fken", "match": "[;,:]" }
  ]
}
