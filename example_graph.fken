// Input: 3 2   1 2 10   1 3 20
struct Road {
    int toll;
    fn with_fee(fee: int) -> int { return self.toll + fee; }
}
int n, m;
cin >> n >> m;
graph G(n);
Road[] roads(m);
rep(i, 0, m) {
    int u, v, cost;
    cin >> u >> v >> cost;
    int id = G.add(u - 1, v - 1, cost);
    roads[id] = Road{toll: cost};
}
if (n > 0) {
    for (edge e : G[0]) {
        cout << e.to + 1 << ' ' << roads[e.id].with_fee(1) << '\n';
    }
}
