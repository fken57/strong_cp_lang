#!/usr/bin/env python3
"""Compile .fken to C++20, or compile and run it locally with --run."""
import argparse
import os
from pathlib import Path
import shlex
import subprocess
import sys
import tempfile

from compiler import BUILD, build_compiler, boost_flags


def main():
    parser = argparse.ArgumentParser(
        description="Compile .fken to C++20. Requires GCC/Clang and Boost headers for --run."
    )
    parser.add_argument("source", nargs="?", help="source file, or - for stdin")
    parser.add_argument("--code", help="source code instead of a file")
    parser.add_argument("-o", "--output", type=Path, help="write generated C++ to this file")
    parser.add_argument("--run", action="store_true", help="compile generated C++ and execute locally")
    parser.add_argument("--check", action="store_true", help="check source without generating C++")
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument("--lsp", action="store_true", help="start the stdio language server")
    modes.add_argument("--web", action="store_true", help="start the local Web editor")
    parser.add_argument("--port", type=int, default=8765, help="local Web editor port")
    parser.add_argument("--version", action="version", version="fken_cpl 0.8.0")
    args = parser.parse_args()
    if args.web and not 0 <= args.port <= 65535:
        parser.error("--port must be between 0 and 65535")
    if args.lsp or args.web:
        if args.source is not None or args.code is not None or args.run or args.check or args.output:
            parser.error("--lsp/--web cannot be combined with source compilation")
        try:
            if args.lsp:
                from lsp_server import run_stdio
                return run_stdio()
            from web_server import serve
            serve(args.port)
            return 0
        except (OSError, subprocess.CalledProcessError) as error:
            print(f"fken_cpl: {error}", file=sys.stderr)
            return 1
    if args.check and (args.run or args.output):
        parser.error("--check cannot be combined with --run or --output")
    if (args.source is None) == (args.code is None):
        parser.error("provide one source file or --code")
    try:
        compiler = build_compiler()
        inputs = ["--code", args.code] if args.code is not None else [args.source]
        result = subprocess.run([str(compiler), *(["--check"] if args.check else []), *inputs], stdout=subprocess.PIPE)
        if result.returncode:
            return result.returncode
        if args.output:
            args.output.write_bytes(result.stdout)
        if not args.run:
            if not args.output:
                sys.stdout.buffer.write(result.stdout)
            return 0
        with tempfile.TemporaryDirectory(prefix="run-", dir=BUILD) as directory:
            work = Path(directory)
            cpp = work / "program.cpp"
            cpp.write_bytes(result.stdout)
            cxx = shlex.split(os.environ.get("CXX", "c++"))
            flags = shlex.split(os.environ.get("CXXFLAGS", ""))
            result = subprocess.run(cxx + [
                "-std=c++20", "-O2", *flags, *boost_flags(),
                str(cpp), "-o", str(work / "program"),
            ])
            if result.returncode:
                return result.returncode
            return subprocess.run([str(work / "program")]).returncode
    except subprocess.CalledProcessError as error:
        return error.returncode
    except OSError as error:
        print(f"fken_cpl: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
